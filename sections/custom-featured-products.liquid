{{ 'custom-featured-products.css' | asset_url | stylesheet_tag }}
{{ 'custom-cart-modal.css' | asset_url | stylesheet_tag }}

{{ 'custom-featured-products.js' | asset_url | script_tag }}
{{ 'custom-cart-modal.js' | asset_url | script_tag }}


    <section
    class="featured-products"
    id="shopify-section-{{ section.id }}"
    >
    <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="featured-products__header">
        <h2 class="featured-products__heading">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    {% assign collection = section.settings.collection %}

    {% if collection != blank %}

      <div
        class="featured-products__grid"
        style="--columns-desktop:{{ section.settings.columns_desktop }};
               --columns-mobile:{{ section.settings.columns_mobile }};"
      >

        {% for product in collection.products limit: section.settings.products_to_show %}

          <div class="featured-product-card">

            <div class="featured-product-card__image-wrapper">

              <a href="{{ product.url }}">

                {% if product.featured_image %}

                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'featured-product-card__image'
                  }}

                {% else %}

                  {{ 'product-1' | placeholder_svg_tag }}

                {% endif %}

              </a>

              {% unless product.available %}
                <span class="featured-product-card__badge sold-out">
                  Sold Out
                </span>
              {% endunless %}

          {% if product.available %}
            <button
                type="button"
                class="featured-product-card__cart"
                data-product-handle="{{ product.handle }}"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                aria-label="Quick Add"
            >
                +
            </button>
            {% endif %}

            </div>

          </div>

        {% endfor %}

      </div>

    {% else %}

      <p>Select a collection from the Theme Editor.</p>

    {% endif %}

  </div>
</section>

{% render 'custom-cart-modal' %}

{% schema %}
{
  "name": "Custom Featured Products",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
    "type": "select",
    "id": "columns_mobile",
    "label": "Mobile Columns",
    "default": "2",
    "options": [
        {
        "value": "1",
        "label": "1 Column"
        },
        {
        "value": "2",
        "label": "2 Columns"
        }
    ]
    }
    ],
  "presets": [
    {
      "name": "Custom Featured Products"
    }
  ]
}
{% endschema %}